# Where the Android dependency packages come from (read by tools/android/fetch-packages.sh).
# Package names, versions and sha256 checksums live in deps/android-deps.packman.xml, which Packman
# also reads; keep the release tag here in step with them.

# GitHub repository and release tag publishing the zips (+ SHA256SUMS).
ANDROID_PACKAGES_REPO=apphaus2/usd-android-packages
ANDROID_PACKAGES_TAG=v25.11+tbb2021.13.0

# Local folder the Packman file remote reads, relative to the repo root. Must match the
# android_packages_dist token in repo.toml.
ANDROID_PACKAGES_DIST=../usd-android-packages/dist
